# APP_VERSION is optional and overrides the installed package version.
# APP_VERSION=
LOG_LEVEL=INFO
ENABLE_INSTRUMENTATION=true
OTEL_SERVICE_NAMESPACE=sundae-funday
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT_DOCKER=http://otel-collector:4318
APPLICATIONINSIGHTS_CONNECTION_STRING=

OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
OPENAI_CHAT_MODEL=qwen3:8b
OPENAI_AUTH_MODE=api_key
OPENAI_API_KEY=ollama

SUNDAE_MCP_URL=http://localhost:8101/mcp/
OPS_AGENT_URL=http://localhost:8202
OPS_AGENT_PUBLIC_BASE_URL=http://localhost:8202
ANALYST_AGENT_URL=http://localhost:8401
ANALYST_PUBLIC_BASE_URL=http://localhost:8401
# sandbox (Agent Sandbox runtime) or inprocess (unsafe demo foil).
ANALYST_EXECUTOR=sandbox
SANDBOX_URL=http://localhost:8888
# Skip hidden reasoning on thinking models; leave empty for models that reject it.
ANALYST_REASONING_EFFORT=none
# Opt-in simulated per-replica work; 0 disables both delay and concurrency cap.
OPS_DEMO_WORK_SECONDS=0
OPS_DEMO_CONCURRENCY=2

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
